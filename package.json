{
    "name": "wasichai-ui",
    "private": true,
    "version": "0.2.1",
    "workspaces": [
        "packages/*"
    ],
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "prepare": "husky",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "yarn workspaces run lint",
        "test": "yarn workspaces run test",
        "test:tooling": "node --test tooling/*.test.mjs",
        "build": "node tooling/run-ordered.mjs build"
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.3",
        "@commitlint/config-conventional": "19.8.1",
        "husky": "9.1.7",
        "prettier": "3.8.2",
        "typescript": "5.9.3"
    }
}

{
    "name": "@wasichai/core",
    "version": "1.9.0",
    "description": "Wasichai app shell, module registry, api client, auth, i18n and the core metadata features",
    "type": "module",
    "files": [
        "dist",
        "README.md"
    ],
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "scripts": {
        "lint": "prettier --check src package.json tsconfig.json tsconfig.build.json vite.config.ts && tsc --noEmit -p tsconfig.json",
        "test": "vitest run",
        "build": "vite build && tsc -p tsconfig.build.json"
    },
    "dependencies": {
        "@wasichai/ui": "*",
        "@hookform/resolvers": "7.0.5",
        "lucide-react": "^1.72.0",
        "react-hook-form": "^7.91.0",
        "zod": "^4.6.7"
    },
    "peerDependencies": {
        "@tanstack/react-query": "^5.103.1",
        "i18next": "^26.4.2",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-i18next": "^17.0.14",
        "react-router": "^8.4.0"
    },
    "devDependencies": {
        "@tanstack/react-query": "5.107.1",
        "@testing-library/dom": "10.4.2",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.9",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.3.0",
        "i18next": "26.7.1",
        "jsdom": "31.0.0",
        "prettier": "3.9.10",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-i18next": "17.1.9",
        "react-router": "8.5.1",
        "typescript": "7.0.2",
        "vite": "8.3.8",
        "vitest": "5.1.0"
    }
}
